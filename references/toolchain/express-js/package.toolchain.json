{
  "//": "pspt toolchain (express-js, JavaScript) — merge into the project's package.json exactly. No TypeScript: the check script skips typecheck.",
  "devDependencies": {
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "knip": "6.39.0",
    "husky": "9.1.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "globals": "17.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "lint:files": "eslint --max-warnings=0 --no-warn-ignored",
    "knip": "knip",
    "check": "prettier --check . && eslint --max-warnings=0 . && knip",
    "prepare": "husky"
  }
}
