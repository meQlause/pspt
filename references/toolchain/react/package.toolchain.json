{
  "//": "pspt toolchain — merge into the project's package.json exactly. Verified with TypeScript >=4.8.4 <6.1.0 (typescript-eslint 8.71 peer range). ESLint stays on 9: eslint-plugin-react, -jsx-a11y and -import do not support 10 yet.",
  "devDependencies": {
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "knip": "6.39.0",
    "husky": "9.1.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1"
  },
  "scripts": {
    "format": "prettier --write . && eslint --fix --fix-type layout .",
    "format:check": "prettier --check . && eslint --max-warnings=0 .",
    "lint": "eslint --max-warnings=0 .",
    "lint:files": "eslint --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "prettier --check . && eslint --max-warnings=0 . && tsc --noEmit && knip",
    "prepare": "husky"
  }
}
